<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>GLOBAL SERVICES</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800&family=Poppins:wght@300;400;500;600;700&display=swap"
rel="stylesheet">

<style>

/* ================= BASE ================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:#f3f7ff;
    overflow-x:hidden;
    color:#111827;
}

/* ================= NAVBAR ================= */

.navbar{
    width:100%;
    height:72px;

    background:rgba(255,255,255,0.9);

    backdrop-filter:blur(16px);

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:0 20px;

    position:sticky;
    top:0;
    z-index:1000;

    border-bottom:
    1px solid rgba(0,0,0,0.08);
}

/* ================= LOGO ================= */

.logo-container{
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    justify-content:center;
}

.main-logo{
    font-family:'Orbitron',sans-serif;
    font-size:18px;
    font-weight:800;
    letter-spacing:1px;
}

.black-text{
    color:#111827;
}

.red-text{
    color:#2563eb;
}

.tagline{
    display:flex;
    align-items:center;
    gap:5px;
    margin-top:2px;
}

.line{
    width:14px;
    height:1px;
    background:#2563eb;
}

.tagline-text{
    font-size:8px;
    letter-spacing:2px;
    color:#6b7280;
}

/* ================= MENU ================= */

.menu{
    display:flex;
    align-items:center;
    gap:12px;
}

.menu a{
    text-decoration:none;
    color:#111827;
    padding:10px 18px;
    border-radius:12px;
    transition:0.3s;
    font-size:14px;
    font-weight:600;
}

.menu a:hover{
    background:#2563eb;
    color:white;
}

/* ================= HAMBURGER ================= */

.hamburger{
    display:none;
    font-size:24px;
    cursor:pointer;
    color:#111827;
}

/* ================= HERO ================= */

.hero{
    width:calc(100% - 24px);

    margin:22px auto;

    min-height:520px;

    border-radius:36px;

    overflow:hidden;

    position:relative;

    padding:28px;

    background:
    linear-gradient(
    135deg,
    #ffffff,
    #e0ecff,
    #dbeafe
    );

    box-shadow:
    0 20px 60px rgba(0,0,0,0.1);
}

/* ================= TOP BANNER ================= */

.top-banner{
    width:100%;

    min-height:220px;

    border-radius:30px;

    overflow:visible;

    position:relative;

    background:
    linear-gradient(
    rgba(0,0,0,0.3),
    rgba(0,0,0,0.4)
    ),

    url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f?q=80&w=1600&auto=format&fit=crop');

    background-size:cover;
    background-position:center;

    display:flex;
    align-items:center;

    padding:35px;
}

/* OVERLAY */

.top-banner::before{
    content:'';

    position:absolute;
    inset:0;

    border-radius:30px;

    background:
    linear-gradient(
    to right,
    rgba(0,0,0,0.6),
    rgba(0,0,0,0.1)
    );
}

/* TEXT */

.banner-content{
    position:relative;
    z-index:5;
    width:65%;
}

.banner-content h1{
    font-size:48px;
    font-weight:800;
    line-height:1.1;
    color:white;
}

.banner-content p{
    margin-top:14px;
    color:#f3f4f6;
    line-height:1.8;
    font-size:16px;
}

/* ================= PVC CARD ================= */

.photo-box{
    position:absolute;

    right:40px;
    bottom:-55px;

    width:160px;
    height:230px;

    border-radius:26px;

    overflow:hidden;

    border:
    3px solid rgba(255,255,255,0.2);

    background:
    rgba(255,255,255,0.1);

    backdrop-filter:blur(12px);

    z-index:10;

    box-shadow:
    0 20px 50px rgba(0,0,0,0.25);
}

.photo-box img{
    width:100%;
    height:100%;
    object-fit:cover;
}

/* ================= CONTENT ================= */

.content{
    position:relative;
    z-index:5;

    margin-top:90px;

    text-align:center;
}

.hero-title{
    font-size:46px;
    font-weight:800;
    color:#111827;
}

.hero-text{
    margin-top:16px;

    color:#374151;

    line-height:1.9;

    font-size:16px;

    max-width:760px;

    margin-left:auto;
    margin-right:auto;
}

/* ================= BUTTONS ================= */

.buttons{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:16px;
    margin-top:30px;
}

.btn{
    text-decoration:none;

    background:
    linear-gradient(
    135deg,
    #2563eb,
    #1d4ed8
    );

    color:white;

    padding:14px 28px;

    border-radius:16px;

    font-weight:600;

    transition:0.3s;

    box-shadow:
    0 10px 25px rgba(37,99,235,0.2);
}

.btn:hover{
    transform:translateY(-4px);
}

/* ================= FEATURES ================= */

.features{
    width:calc(100% - 24px);

    margin:28px auto;

    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(240px,1fr));

    gap:20px;
}

/* CARD */

.card{
    background:white;

    border:
    1px solid rgba(0,0,0,0.06);

    padding:34px;

    border-radius:26px;

    text-align:center;

    transition:0.3s;

    box-shadow:
    0 10px 30px rgba(0,0,0,0.06);
}

.card:hover{
    transform:translateY(-6px);
}

.card i{
    font-size:42px;
    color:#2563eb;
    margin-bottom:14px;
}

.card h3{
    font-size:22px;
    margin-bottom:10px;
}

.card p{
    color:#6b7280;
    font-size:14px;
    line-height:1.8;
}

/* ================= SOCIAL BOX ================= */

.social-box{

    width:calc(100% - 24px);

    max-width:420px;

    margin:30px auto;

    background:white;

    border-radius:30px;

    padding:35px 25px;

    text-align:center;

    box-shadow:
    0 12px 40px rgba(0,0,0,0.08);

    transition:0.3s;
}

.social-box:hover{

    transform:translateY(-6px);
}

/* LOGO */

.social-logo{

    width:110px;
    height:110px;

    margin:auto;

    border-radius:50%;

    overflow:hidden;

    border:5px solid #2563eb;

    box-shadow:
    0 10px 25px rgba(37,99,235,0.25);
}

.social-logo img{

    width:100%;
    height:100%;

    object-fit:cover;
}

/* TEXT */

.social-box h2{

    margin-top:20px;

    font-size:28px;

    color:#111827;

    font-weight:700;
}

.social-box p{

    margin-top:8px;

    color:#6b7280;

    font-size:15px;

    line-height:1.7;
}

/* SOCIAL ICONS */

.social-icons{

    display:flex;

    justify-content:center;

    gap:15px;

    margin-top:28px;

    flex-wrap:wrap;
}

.social-icons a{

    width:52px;
    height:52px;

    display:flex;

    align-items:center;
    justify-content:center;

    border-radius:50%;

    text-decoration:none;

    font-size:22px;

    color:white;

    transition:0.3s;
}

.social-icons a:nth-child(1){
    background:#1877f2;
}

.social-icons a:nth-child(2){
    background:#e1306c;
}

.social-icons a:nth-child(3){
    background:#ff0000;
}

.social-icons a:nth-child(4){
    background:#25d366;
}

.social-icons a:nth-child(5){
    background:#0088cc;
}

.social-icons a:hover{

    transform:
    translateY(-5px)
    scale(1.08);

    box-shadow:
    0 8px 18px rgba(0,0,0,0.15);
}

/* ================= MOBILE ================= */

@media(max-width:768px){

    .hamburger{
        display:block;
    }

    .menu{
        position:absolute;
        top:72px;
        left:0;
        width:100%;

        background:white;

        flex-direction:column;

        align-items:flex-start;

        padding:15px;

        display:none;

        box-shadow:0 10px 20px rgba(0,0,0,0.08);
    }

    .menu.active{
        display:flex;
    }

    .menu a{
        width:100%;
    }

    .hero{
        padding:18px;
        border-radius:26px;
    }

    .top-banner{
        min-height:170px;
        padding:22px;
    }

    .banner-content{
        width:100%;
    }

    .banner-content h1{
        font-size:30px;
    }

    .banner-content p{
        font-size:13px;
    }

    .photo-box{
        width:105px;
        height:150px;

        right:16px;
        bottom:-38px;

        border-radius:18px;
    }

    .content{
        margin-top:65px;
    }

    .hero-title{
        font-size:30px;
    }

    .hero-text{
        font-size:14px;
    }

    .buttons{
        flex-direction:column;
    }

    .btn{
        width:100%;
        text-align:center;
    }

    .social-box{
        width:95%;
        padding:30px 20px;
    }

    .social-box h2{
        font-size:24px;
    }

}

</style>

</head>

<body>

<!-- ================= NAVBAR ================= -->

<div class="navbar">

    <div class="logo-container">

        <div class="main-logo">

            <span class="black-text">
                GLOBAL
            </span>

            <span class="red-text">
                SERVICES
            </span>

        </div>

        <div class="tagline">

            <span class="line"></span>

            <span class="tagline-text">
                SAFE & SECURE
            </span>

            <span class="line"></span>

        </div>

    </div>

    <!-- HAMBURGER -->

    <div class="hamburger" id="hamburger">
        <i class="fa-solid fa-bars"></i>
    </div>

    <!-- MENU -->

    <div class="menu" id="menu">

        <a href="/">Home</a>

        <a href="/student">Student</a>

        <a href="/customer">Customer</a>

        <a href="/admin">Admin</a>

        <a href="/gs">G & S</a>

    </div>

</div>

<!-- ================= HERO ROOT ================= -->

<div id="heroRoot"></div>

<!-- ================= FEATURES ================= -->

<div class="features">

    <div class="card">

        <i class="fa-solid fa-user-graduate"></i>

        <h3>
            Student Panel
        </h3>

        <p>
            Manage students, attendance and performance with modern dashboard.
        </p>

    </div>

    <div class="card">

        <i class="fa-solid fa-file-lines"></i>

        <h3>
            Notes System
        </h3>

        <p>
            Upload and access coaching notes easily from anywhere.
        </p>

    </div>

    <div class="card">

        <i class="fa-solid fa-chart-line"></i>

        <h3>
            Dashboard
        </h3>

        <p>
            Track payments, student records and analytics in real time.
        </p>

    </div>

</div>

<!-- ================= SOCIAL MEDIA BOX ================= -->

<div class="social-box">

    <div class="social-logo">

        <img
        src="https://i.ibb.co/7QpKsCX/logo.png"
        alt="logo">

    </div>

    <h2>
        GLOBAL SERVICES
    </h2>

    <p>
        Follow us on social media platforms for latest updates and services.
    </p>

    <div class="social-icons">

        <a href="#">
            <i class="fa-brands fa-facebook-f"></i>
        </a>

        <a href="#">
            <i class="fa-brands fa-instagram"></i>
        </a>

        <a href="https://youtube.com/@g_s_coder?si=U7izCYU0T8JqB6qu">
            <i class="fa-brands fa-youtube"></i>
        </a>

        <a href="https://wa.me/919142264714?text=Hello%20GLOBAL%20SERVICES" target="_blank">
    <i class="fa-brands fa-whatsapp"></i>
</a>

        <a href="#">
            <i class="fa-brands fa-telegram"></i>
        </a>

    </div>

</div>

<!-- ================= SCRIPT ================= -->

<script>

/* ================= MOBILE MENU ================= */

const hamburger =
document.getElementById("hamburger");

const menu =
document.getElementById("menu");

hamburger.onclick = () => {
    menu.classList.toggle("active");
};

/* ================= LOAD HERO ================= */

const heroData =
JSON.parse(
localStorage.getItem("heroData")
);

const heroRoot =
document.getElementById("heroRoot");

/* ================= IF HERO AVAILABLE ================= */

if(heroData){

heroRoot.innerHTML = `

<div class="hero">

    <div class="top-banner"

    style="
    background:
    linear-gradient(
    rgba(0,0,0,0.45),
    rgba(0,0,0,0.55)
    ),

    url('${heroData.bannerURL}');

    background-size:cover;
    background-position:center;
    ">

        <div class="banner-content">

            <h1>
                ${heroData.title}
            </h1>

            <p>
                ${heroData.desc}
            </p>

        </div>

        <div class="photo-box">

            <img
            src="${heroData.logoURL}"
            alt="logo">

        </div>

    </div>

    <div class="content">

        <h2 class="hero-title">
            ${heroData.title}
        </h2>

        <p class="hero-text">
            ${heroData.desc}
        </p>

        <div class="buttons">

            <a href="/student"
            class="btn">
                Student Panel
            </a>

            <a href="/admin"
            class="btn">
                Admin Panel
            </a>

            <a href="/customer"
            class="btn">
                Customer Panel
            </a>

        </div>

    </div>

</div>

`;

}

</script>

</body>
</html>
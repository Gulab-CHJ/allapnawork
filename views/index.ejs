<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>GLOBAL SERVICES</title>

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"/>

<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700;800&family=Poppins:wght@300;400;500;600;700&display=swap"
rel="stylesheet">

<style>

/* ================= BASE ================= */

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{
    background:#050816;
    overflow-x:hidden;
    color:white;
}

/* ================= NAVBAR ================= */

.navbar{
    width:100%;
    height:72px;

    background:
    rgba(5,8,22,0.82);

    backdrop-filter:blur(16px);

    display:flex;
    justify-content:space-between;
    align-items:center;

    padding:0 20px;

    position:sticky;
    top:0;
    z-index:1000;

    border-bottom:
    1px solid rgba(255,255,255,0.06);
}

/* ================= LOGO ================= */

.logo-container{
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
}

.main-logo{
    font-family:'Orbitron',sans-serif;
    font-size:18px;
    font-weight:800;
    letter-spacing:1px;
}

.black-text{
    color:white;
}

.red-text{
    color:#ff2b2b;
}

.tagline{
    display:flex;
    align-items:center;
    gap:5px;
    margin-top:2px;
}

.line{
    width:14px;
    height:1px;
    background:#ff2b2b;
}

.tagline-text{
    font-size:8px;
    letter-spacing:2px;
    color:#d1d5db;
}

/* ================= MENU ================= */

.menu{
    display:flex;
    align-items:center;
    gap:12px;
}

.menu a{
    text-decoration:none;
    color:white;
    padding:10px 18px;
    border-radius:12px;
    transition:0.3s;
    font-size:14px;
    font-weight:500;
}

.menu a:hover{
    background:white;
    color:#111827;
}

/* ================= HERO ================= */

.hero{
    width:calc(100% - 24px);

    margin:22px auto;

    min-height:520px;

    border-radius:36px;

    overflow:hidden;

    position:relative;

    padding:28px;

    background:
    linear-gradient(
    135deg,
    #0f172a,
    #111827,
    #1e1b4b
    );

    box-shadow:
    0 25px 80px rgba(0,0,0,0.5);
}

/* GLOW */

.hero::before{
    content:'';

    position:absolute;

    width:450px;
    height:450px;

    background:#4f46e5;

    opacity:0.2;

    filter:blur(140px);

    border-radius:50%;

    top:-140px;
    right:-120px;
}

/* ================= TOP BANNER ================= */

.top-banner{
    width:100%;

    min-height:220px;

    border-radius:30px;

    overflow:visible;

    position:relative;

    background:
    linear-gradient(
    rgba(0,0,0,0.4),
    rgba(0,0,0,0.5)
    ),

    url('https://images.unsplash.com/photo-1522202176988-66273c2fd55f?q=80&w=1600&auto=format&fit=crop');

    background-size:cover;
    background-position:center;

    display:flex;
    align-items:center;

    padding:35px;
}

/* OVERLAY */

.top-banner::before{
    content:'';

    position:absolute;
    inset:0;

    border-radius:30px;

    background:
    linear-gradient(
    to right,
    rgba(2,6,23,0.85),
    rgba(15,23,42,0.2)
    );
}

/* TEXT */

.banner-content{
    position:relative;
    z-index:5;
    width:65%;
}

.banner-content h1{
    font-size:48px;
    font-weight:800;
    line-height:1.1;
}

.banner-content p{
    margin-top:14px;
    color:#dbe4ff;
    line-height:1.8;
    font-size:16px;
}

/* ================= PVC CARD ================= */

.photo-box{
    position:absolute;

    right:40px;
    bottom:-55px;

    width:160px;
    height:230px;

    border-radius:26px;

    overflow:hidden;

    border:
    3px solid rgba(255,255,255,0.15);

    background:
    rgba(255,255,255,0.08);

    backdrop-filter:blur(12px);

    z-index:10;

    box-shadow:
    0 20px 50px rgba(0,0,0,0.5);
}

.photo-box img{
    width:100%;
    height:100%;
    object-fit:cover;
}

/* ================= CONTENT ================= */

.content{
    position:relative;
    z-index:5;

    margin-top:90px;

    text-align:center;
}

.hero-title{
    font-size:46px;
    font-weight:800;
}

.hero-text{
    margin-top:16px;

    color:#dbe4ff;

    line-height:1.9;

    font-size:16px;

    max-width:760px;

    margin-left:auto;
    margin-right:auto;
}

/* ================= BUTTONS ================= */

.buttons{
    display:flex;
    justify-content:center;
    flex-wrap:wrap;
    gap:16px;
    margin-top:30px;
}

.btn{
    text-decoration:none;

    background:
    linear-gradient(
    135deg,
    #2563eb,
    #1e40af
    );

    color:white;

    padding:14px 28px;

    border-radius:16px;

    font-weight:600;

    transition:0.3s;

    box-shadow:
    0 10px 25px rgba(37,99,235,0.3);
}

.btn:hover{
    transform:translateY(-4px);
}

/* ================= FEATURES ================= */

.features{
    width:calc(100% - 24px);

    margin:28px auto;

    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(240px,1fr));

    gap:20px;
}

/* CARD */

.card{
    background:
    rgba(255,255,255,0.05);

    border:
    1px solid rgba(255,255,255,0.08);

    padding:34px;

    border-radius:26px;

    text-align:center;

    backdrop-filter:blur(12px);

    transition:0.3s;
}

.card:hover{
    transform:translateY(-6px);
}

.card i{
    font-size:42px;
    color:#3b82f6;
    margin-bottom:14px;
}

.card h3{
    font-size:22px;
    margin-bottom:10px;
}

.card p{
    color:#cbd5e1;
    font-size:14px;
    line-height:1.8;
}

/* ================= MOBILE ================= */

@media(max-width:768px){

    .menu{
        gap:6px;
    }

    .menu a{
        padding:8px 12px;
        font-size:12px;
    }

    .hero{
        padding:18px;
        border-radius:26px;
    }

    .top-banner{
        min-height:170px;
        padding:22px;
    }

    .banner-content{
        width:100%;
    }

    .banner-content h1{
        font-size:30px;
    }

    .banner-content p{
        font-size:13px;
    }

    .photo-box{
        width:105px;
        height:150px;

        right:16px;
        bottom:-38px;

        border-radius:18px;
    }

    .content{
        margin-top:65px;
    }

    .hero-title{
        font-size:30px;
    }

    .hero-text{
        font-size:14px;
    }

    .buttons{
        flex-direction:column;
    }

    .btn{
        width:100%;
        text-align:center;
    }

}

</style>

</head>

<body>

<!-- ================= NAVBAR ================= -->

<div class="navbar">

    <div class="logo-container">

        <div class="main-logo">

            <span class="black-text">
                GLOBAL
            </span>

            <span class="red-text">
                SERVICES
            </span>

        </div>

        <div class="tagline">

            <span class="line"></span>

            <span class="tagline-text">
                SAFE & SECURE
            </span>

            <span class="line"></span>

        </div>

    </div>

    <!-- MENU -->

    <div class="menu">

        <a href="/">Home</a>

        <a href="/student">Student</a>

        <a href="/customer">Customer</a>

        <a href="/admin">Admin</a>

        <a href="/gs">G & S</a>

    </div>

</div>

<!-- ================= HERO ROOT ================= -->

<div id="heroRoot"></div>

<!-- ================= FEATURES ================= -->

<div class="features">

    <div class="card">

        <i class="fa-solid fa-user-graduate"></i>

        <h3>
            Student Panel
        </h3>

        <p>
            Manage students, attendance and performance with modern dashboard.
        </p>

    </div>

    <div class="card">

        <i class="fa-solid fa-file-lines"></i>

        <h3>
            Notes System
        </h3>

        <p>
            Upload and access coaching notes easily from anywhere.
        </p>

    </div>

    <div class="card">

        <i class="fa-solid fa-chart-line"></i>

        <h3>
            Dashboard
        </h3>

        <p>
            Track payments, student records and analytics in real time.
        </p>

    </div>

</div>

<!-- ================= SCRIPT ================= -->

<script>

/* ================= LOAD HERO ================= */

const heroData =
JSON.parse(
localStorage.getItem("heroData")
);

const heroRoot =
document.getElementById("heroRoot");

/* ================= IF HERO AVAILABLE ================= */

if(heroData){

heroRoot.innerHTML = `

<div class="hero">

    <!-- TOP BANNER -->

    <div class="top-banner"

    style="
    background:
    linear-gradient(
    rgba(0,0,0,0.45),
    rgba(0,0,0,0.55)
    ),

    
    url('${heroData.bannerURL}');
    
    background-size:cover;
    background-position:center;
    ">

        <!-- TEXT -->

        <div class="banner-content">

            <h1>
                ${heroData.title}
            </h1>

            <p>
                ${heroData.desc}
            </p>

        </div>

        <!-- PVC PHOTO -->

        <div class="photo-box">

            <img
            src="${heroData.logoURL}"
            alt="logo">

        </div>

    </div>

    <!-- CONTENT -->

    <div class="content">

        <h2 class="hero-title">
            ${heroData.title}
        </h2>

        <p class="hero-text">
            ${heroData.desc}
        </p>

        <!-- BUTTONS -->

        <div class="buttons">

            <a href="/student"
            class="btn">
                Student Panel
            </a>

            <a href="/admin"
            class="btn">
                Admin Panel
            </a>

            <a href="/customer"
            class="btn">
                Customer Panel
            </a>

        </div>

    </div>

</div>

`;

}

/* ================= HERO EMPTY ================= */

else{

heroRoot.innerHTML = ``;

}

</script>

</body>

</html>
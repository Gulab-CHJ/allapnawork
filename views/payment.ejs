<!-- views/payment.ejs -->

<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Premium Payment</title>

<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}

body{

    font-family:Arial,sans-serif;

    background:
    radial-gradient(circle at top left,#2563eb,#111827 55%);

    min-height:100vh;

    display:flex;

    justify-content:center;

    align-items:center;

    overflow:hidden;

    position:relative;
}

body::before{

    content:"";

    position:absolute;

    width:350px;

    height:350px;

    background:rgba(255,255,255,0.08);

    border-radius:50%;

    top:-100px;

    left:-100px;

    filter:blur(10px);
}

body::after{

    content:"";

    position:absolute;

    width:300px;

    height:300px;

    background:rgba(37,99,235,0.3);

    border-radius:50%;

    bottom:-100px;

    right:-100px;

    filter:blur(20px);
}

.card{

    position:relative;

    z-index:10;

    width:90%;

    max-width:430px;

    background:rgba(255,255,255,0.12);

    backdrop-filter:blur(18px);

    border:1px solid rgba(255,255,255,0.15);

    border-radius:28px;

    padding:35px 30px;

    text-align:center;

    box-shadow:
    0 10px 40px rgba(0,0,0,0.4);

    color:white;

    animation:fadeIn 0.6s ease;
}

.logo{

    width:85px;

    height:85px;

    margin:auto;

    border-radius:50%;

    background:linear-gradient(135deg,#3b82f6,#1d4ed8);

    display:flex;

    justify-content:center;

    align-items:center;

    font-size:36px;

    box-shadow:0 8px 25px rgba(37,99,235,0.5);
}

h1{

    margin-top:20px;

    font-size:30px;

    font-weight:bold;

    color:white;
}

.subtitle{

    margin-top:10px;

    color:#dbeafe;

    line-height:1.6;

    font-size:15px;
}

.price{

    margin:28px 0 10px;

    font-size:52px;

    font-weight:bold;

    color:#ffffff;

    text-shadow:0 5px 15px rgba(0,0,0,0.3);
}

.price span{

    font-size:20px;

    opacity:0.8;
}

.features{

    margin-top:25px;

    text-align:left;
}

.features p{

    margin:10px 0;

    font-size:15px;

    color:#e5e7eb;
}

.payBtn{

    width:100%;

    padding:15px;

    margin-top:30px;

    border:none;

    border-radius:14px;

    background:linear-gradient(135deg,#3b82f6,#2563eb);

    color:white;

    font-size:17px;

    font-weight:bold;

    cursor:pointer;

    transition:0.3s;

    box-shadow:0 10px 25px rgba(37,99,235,0.45);
}

.payBtn:hover{

    transform:translateY(-2px) scale(1.01);

    background:linear-gradient(135deg,#2563eb,#1d4ed8);
}

.secure{

    margin-top:18px;

    font-size:13px;

    color:#d1d5db;
}

@keyframes fadeIn{

    from{
        opacity:0;
        transform:translateY(25px);
    }

    to{
        opacity:1;
        transform:translateY(0);
    }
}

</style>

</head>

<body>

<div class="card">

    <div class="logo">
        🎓
    </div>

    <h1>Premium Registration</h1>

    <p class="subtitle">
        Complete your secure payment to activate your student premium account instantly.
    </p>

    <div class="price">
        ₹299
        <span>only</span>
    </div>

    <div class="features">

        <p>✅ Instant Account Activation</p>

        <p>✅ Secure Razorpay Payment</p>

        <p>✅ Student Dashboard Access</p>

        <p>✅ Registration Confirmation</p>

    </div>

    <button class="payBtn" onclick="payNow()">
        Pay Securely Now
    </button>

    <div class="secure">
        🔒 100% Secure Payment Powered by Razorpay
    </div>

</div>

<script>

async function payNow(){

try{

    const res = await fetch("/create-order",{
        method:"POST"
    });

    const data = await res.json();

    console.log(data);

    if(!data.success){

        alert("Order Failed");

        return;
    }

    const options = {

        key:"rzp_test_SrzTcHdvE8Qbkq",

        amount:data.order.amount,

        currency:data.order.currency,

        name:"Student Registration",

        description:"Premium Registration",

        order_id:data.order.id,

        handler: async function(response){

            try{

                const rawData =
                localStorage.getItem("studentData");

                if(!rawData){

                    alert("Student data missing!");

                    return;
                }

                const studentData =
                JSON.parse(rawData);

                studentData.razorpay_payment_id =
                response.razorpay_payment_id;

                const saveRes =
                await fetch("/payment-success-save", {

                    method: "POST",

                    headers: {
                        "Content-Type": "application/json"
                    },

                    body: JSON.stringify({

                        ...studentData,

                        payment_id:
                        response.razorpay_payment_id
                    })
                });

                const saveData =
                await saveRes.json();

                alert(saveData.message);

                if(saveData.success){

                    window.location.href =
                    "/payment-success";
                }

            }catch(err){

                console.log(err);

                alert("Save Error");
            }

        },

        theme:{
            color:"#2563eb"
        }
    };

    const rzp = new Razorpay(options);

    rzp.on('payment.failed', function (response){

        console.log(response.error);

        alert(response.error.description);
    });

    rzp.open();

}catch(err){

    console.log(err);

    alert("Payment Error");
}

}

</script>

</body>
</html>
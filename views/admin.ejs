<script>

/* ================= FETCH STUDENTS ================= */
function loadStudents(){

fetch("/api/students")
.then(res => res.json())
.then(data => {

    let html = "";

    data.forEach(s => {

        let paymentStatus = s.paymentId ? 
            `<span class="status-paid">Paid</span>` :
            `<span class="status-unpaid">Pending</span>`;

        html += `
        <tr>
            <td>${s.name || "-"}</td>
            <td>${s.phone || "-"}</td>
            <td>${s.className || "-"}</td>
            <td>${s.email || "-"}</td>

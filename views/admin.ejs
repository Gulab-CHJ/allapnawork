<body>

<div class="admin-panel">

    <h2>
        Hero Admin Panel
    </h2>

    <!-- TITLE -

    <input
    type="text"
    id="titleInput"
    placeholder="Hero Title">

    <!-- DESCRIPTION -

    <textarea
    id="descInput"
    placeholder="Hero Description"></textarea>

    <!-- PVC IMAGE -

    <label>
        Upload PVC Image
    </label>

    <input
    type="file"
    id="logoInput"
    accept="image/*">

    <!-- BANNER IMAGE -

    <label>
        Upload Banner Image
    </label>

    <input
    type="file"
    id="bannerInput"
    accept="image/*">

    <!-- BUTTON -

    <button onclick="saveHero()">

        Save Hero

    </button>

    <!-- STATUS -

    <div class="status"
    id="status"></div>

    <!-- HERO LIST -

    <div class="hero-list"
    id="heroList"></div>

</div>

<script>

let editIndex = -1;

/* ================= LOAD ================= */

window.onload = function(){

    renderHeroes();

}

/* ================= SAVE HERO ================= */

function saveHero(){

    const title =
    document.getElementById(
    "titleInput").value;

    const desc =
    document.getElementById(
    "descInput").value;

    const logoFile =
    document.getElementById(
    "logoInput").files[0];

    const bannerFile =
    document.getElementById(
    "bannerInput").files[0];

    const status =
    document.getElementById(
    "status");

    if(!title || !desc){

        status.innerText =
        "❌ Fill all fields";

        return;
    }

    const logoReader =
    new FileReader();

    const bannerReader =
    new FileReader();

    logoReader.onload = function(e){

        const logoBase64 =
        logoFile ?
        e.target.result :
        "";

        bannerReader.onload =
        function(ev){

            const bannerBase64 =
            bannerFile ?
            ev.target.result :
            "";

            const hero = {

                title,
                desc,

                logoURL:
                logoBase64,

                bannerURL:
                bannerBase64

            };

            let heroes =
            JSON.parse(
            localStorage.getItem(
            "heroes")) || [];

            /* EDIT */

            if(editIndex >= 0){

                heroes[editIndex] =
                hero;

                editIndex = -1;

            }else{

                heroes.push(hero);

            }

            /* SAVE HERO LIST */

            localStorage.setItem(
            "heroes",
            JSON.stringify(heroes)
            );

            /* SAVE ACTIVE HERO */

            localStorage.setItem(
            "heroData",
            JSON.stringify(hero)
            );

            status.innerText =
            "✅ Hero Saved Successfully";

            clearForm();

            renderHeroes();

        }

        if(bannerFile){

            bannerReader.readAsDataURL(
            bannerFile);

        }else{

            bannerReader.onload({
                target:{
                    result:""
                }
            });

        }

    }

    if(logoFile){

        logoReader.readAsDataURL(
        logoFile);

    }else{

        logoReader.onload({
            target:{
                result:""
            }
        });

    }

}

/* ================= RENDER HEROES ================= */

function renderHeroes(){

    const heroList =
    document.getElementById(
    "heroList");

    let heroes =
    JSON.parse(
    localStorage.getItem(
    "heroes")) || [];

    heroList.innerHTML = "";

    heroes.forEach((hero,index)=>{

        heroList.innerHTML += `

        <div class="hero-item">

            <h3>
                ${hero.title}
            </h3>

            <p style="margin-top:8px;color:#cbd5e1;">
                ${hero.desc}
            </p>

            ${
                hero.bannerURL ?

                `<img src="${hero.bannerURL}">`

                :

                ""

            }

            <div class="actions">

                <button
                class="action-btn edit-btn"
                onclick="editHero(${index})">

                    Edit

                </button>

                <button
                class="action-btn delete-btn"
                onclick="deleteHero(${index})">

                    Delete

                </button>

            </div>

        </div>

        `;

    });

}

/* ================= EDIT ================= */

function editHero(index){

    let heroes =
    JSON.parse(
    localStorage.getItem(
    "heroes")) || [];

    const hero =
    heroes[index];

    document.getElementById(
    "titleInput").value =
    hero.title;

    document.getElementById(
    "descInput").value =
    hero.desc;

    editIndex = index;

    document.getElementById(
    "status").innerText =
    "✏️ Edit Mode Enabled";

}

/* ================= DELETE ================= */

function deleteHero(index){

    let heroes =
    JSON.parse(
    localStorage.getItem(
    "heroes")) || [];

    /* DELETE */

    heroes.splice(index,1);

    /* UPDATE STORAGE */

    localStorage.setItem(
    "heroes",
    JSON.stringify(heroes)
    );

    /* UPDATE HOME PAGE HERO */

    if(heroes.length > 0){

        localStorage.setItem(
        "heroData",
        JSON.stringify(
        heroes[heroes.length - 1]
        )
        );

    }else{

        localStorage.removeItem(
        "heroData"
        );

    }

    renderHeroes();

    document.getElementById(
    "status").innerText =
    "🗑 Hero Deleted Successfully";

}

/* ================= CLEAR ================= */

function clearForm(){

    document.getElementById(
    "titleInput").value = "";

    document.getElementById(
    "descInput").value = "";

    document.getElementById(
    "logoInput").value = "";

    document.getElementById(
    "bannerInput").value = "";

}

</script>

</body>

</html> -->
<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Premium Hero Admin</title>

<link rel="preconnect"
href="https://fonts.googleapis.com">

<link rel="preconnect"
href="https://fonts.gstatic.com"
crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
rel="stylesheet">

<style>

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:'Poppins',sans-serif;
}

body{

    background:
    linear-gradient(
    135deg,
    #020617,
    #0f172a,
    #111827);

    min-height:100vh;

    color:white;

    display:flex;
}

/* SIDEBAR */

.sidebar{

    width:260px;

    background:
    rgba(15,23,42,.95);

    border-right:
    1px solid rgba(255,255,255,.08);

    padding:25px;

    position:fixed;

    top:0;
    left:0;
    bottom:0;

    backdrop-filter:blur(12px);
}

.logo{

    font-size:28px;

    font-weight:800;

    color:#3b82f6;

    margin-bottom:35px;
}

.menu{

    display:flex;

    flex-direction:column;

    gap:12px;
}

.menu button{

    padding:15px;

    border:none;

    border-radius:14px;

    background:#111827;

    color:white;

    font-size:15px;

    font-weight:600;

    cursor:pointer;

    transition:.3s;
}

.menu button:hover{

    background:#2563eb;

    transform:translateX(5px);
}

.active{

    background:#2563eb !important;
}

/* MAIN */

.main{

    margin-left:260px;

    width:100%;

    padding:30px;
}

/* PAGE */

.page{

    display:none;
}

.show{

    display:block;
}

/* CARD */

.card{

    background:
    rgba(17,24,39,.75);

    border:
    1px solid rgba(255,255,255,.06);

    border-radius:25px;

    padding:28px;

    backdrop-filter:blur(10px);

    box-shadow:
    0 10px 40px rgba(0,0,0,.35);
}

/* TITLE */

.heading{

    font-size:30px;

    font-weight:700;

    margin-bottom:25px;
}

/* INPUTS */

.input-box{

    width:100%;

    margin-top:16px;

    padding:16px;

    border:none;

    outline:none;

    border-radius:14px;

    background:#1e293b;

    color:white;

    font-size:15px;
}

textarea{

    resize:none;

    height:130px;
}

/* BUTTON */

.save-btn{

    width:100%;

    margin-top:22px;

    padding:16px;

    border:none;

    border-radius:14px;

    background:
    linear-gradient(
    135deg,
    #2563eb,
    #1d4ed8);

    color:white;

    font-size:17px;

    font-weight:700;

    cursor:pointer;

    transition:.3s;
}

.save-btn:hover{

    transform:translateY(-2px);

    box-shadow:
    0 10px 25px rgba(37,99,235,.35);
}

/* STATUS */

.status{

    margin-top:15px;

    text-align:center;

    color:#86efac;

    font-weight:600;
}

/* HERO GRID */

.hero-grid{

    display:grid;

    grid-template-columns:
    repeat(auto-fit,minmax(320px,1fr));

    gap:22px;
}

/* HERO CARD */

.hero-card{

    background:
    rgba(17,24,39,.9);

    border:
    1px solid rgba(255,255,255,.06);

    border-radius:22px;

    overflow:hidden;

    transition:.3s;
}

.hero-card:hover{

    transform:translateY(-5px);
}

.banner{

    width:100%;

    height:220px;

    object-fit:cover;
}

/* CONTENT */

.hero-content{

    padding:20px;
}

.hero-top{

    display:flex;

    align-items:center;

    gap:15px;

    margin-bottom:15px;
}

.logo-img{

    width:75px;

    height:75px;

    border-radius:50%;

    object-fit:cover;

    border:4px solid #2563eb;
}

.hero-title{

    font-size:22px;

    font-weight:700;
}

.hero-desc{

    color:#cbd5e1;

    line-height:1.7;

    margin-top:12px;
}

/* BUTTON GROUP */

.btn-group{

    display:flex;

    gap:12px;

    margin-top:20px;
}

/* ACTION BUTTON */

.action-btn{

    flex:1;

    border:none;

    padding:13px;

    border-radius:12px;

    color:white;

    font-weight:700;

    cursor:pointer;
}

.edit-btn{

    background:#f59e0b;
}

.delete-btn{

    background:#ef4444;
}

/* RESPONSIVE */

@media(max-width:900px){

    .sidebar{

        width:100%;

        height:auto;

        position:relative;
    }

    body{

        flex-direction:column;
    }

    .main{

        margin-left:0;
    }

}

</style>

</head>

<body>

<!-- SIDEBAR -->

<div class="sidebar">

    <div class="logo">
        HERO ADMIN
    </div>

    <div class="menu">

        <button
        class="active"
        onclick="showPage('addPage',this)">

            Add Hero

        </button>

        <button
        onclick="showPage('listPage',this)">

            Hero Listings

        </button>

    </div>

</div>

<!-- MAIN -->

<div class="main">

    <!-- ADD PAGE -->

    <div
    class="page show"
    id="addPage">

        <div class="card">

            <div class="heading">
                Create Premium Hero
            </div>

            <input
            type="text"
            id="titleInput"
            class="input-box"
            placeholder="Hero Title">

            <textarea
            id="descInput"
            class="input-box"
            placeholder="Hero Description"></textarea>

            <input
            type="file"
            id="logoInput"
            class="input-box"
            accept="image/*">

            <input
            type="file"
            id="bannerInput"
            class="input-box"
            accept="image/*">

            <button
            class="save-btn"
            onclick="saveHero()">

                Save Hero

            </button>

            <div
            class="status"
            id="status"></div>

        </div>

    </div>

    <!-- LIST PAGE -->

    <div
    class="page"
    id="listPage">

        <div class="heading">
            Hero Listings
        </div>

        <div
        class="hero-grid"
        id="heroList"></div>

    </div>

</div>

<script>

let editIndex = -1;

/* PAGE SWITCH */

function showPage(pageId,btn){

    document
    .querySelectorAll(".page")
    .forEach(page=>{

        page.classList.remove("show");

    });

    document
    .getElementById(pageId)
    .classList.add("show");

    document
    .querySelectorAll(".menu button")
    .forEach(button=>{

        button.classList.remove("active");

    });

    btn.classList.add("active");

}

/* LOAD */

window.onload = function(){

    renderHeroes();

}

/* SAVE HERO */
async function saveHero(){

    const title =
    document.getElementById(
    "titleInput").value;

    const desc =
    document.getElementById(
    "descInput").value;

    const logo =
    document.getElementById(
    "logoInput").files[0];

    const banner =
    document.getElementById(
    "bannerInput").files[0];

    const status =
    document.getElementById(
    "status");

    if(!title || !desc){

        status.innerText =
        "❌ Fill All Fields";

        return;

    }

    const formData =
    new FormData();

    formData.append(
    "title",
    title
    );

    formData.append(
    "desc",
    desc
    );

    if(logo){

        formData.append(
        "logo",
        logo
        );

    }

    if(banner){

        formData.append(
        "banner",
        banner
        );

    }

    try{

        const res =
        await fetch(

        "/api/heroes",

        {

            method:"POST",

            body:formData

        });

        const data =
        await res.json();

        if(data.success){

            status.innerText =
            "✅ Hero Saved";

            renderHeroes();

            clearForm();

        }

        else{

            status.innerText =
            "❌ Save Failed";

        }

    }

    catch(err){

        console.log(err);

        status.innerText =
        "❌ Server Error";

    }

}
/* SAVE LOCAL */

function saveLocal(hero){

    let heroes =
    JSON.parse(
    localStorage.getItem(
    "heroes")) || [];

    if(editIndex >= 0){

        heroes[editIndex] = {

            ...heroes[editIndex],
            ...hero

        };

        editIndex = -1;

    }

    else{

        heroes.push(hero);

    }

    localStorage.setItem(
    "heroes",
    JSON.stringify(heroes)
    );

    renderHeroes();

    clearForm();

    document
    .getElementById(
    "status").innerText =
    "✅ Hero Saved Successfully";

}

/* RENDER HEROES */
async function renderHeroes(){

    const heroList =
    document.getElementById(
    "heroList"
    );

    heroList.innerHTML =
    "Loading...";

    try{

        const res =
        await fetch(
        "/api/heroes"
        );

        const heroes =
        await res.json();

        heroList.innerHTML = "";

        heroes.forEach((hero)=>{

            heroList.innerHTML += `

            <div class="hero-card">

                <img
                src="${hero.bannerURL || ''}"
                class="banner">

                <div class="hero-content">

                    <div class="hero-top">

                        <img
                        src="${hero.logoURL || ''}"
                        class="logo-img">

                        <div
                        class="hero-title">

                            ${hero.title}

                        </div>

                    </div>

                    <div
                    class="hero-desc">

                        ${hero.desc}

                    </div>

                    <div class="btn-group">

                        <button
                        class="action-btn edit-btn"
                        onclick="editHero('${hero._id}')">

                            Edit

                        </button>

                        <button
                        class="action-btn delete-btn"
                        onclick="deleteHero('${hero._id}')">

                            Delete

                        </button>

                    </div>

                </div>

            </div>

            `;

        });

    }

    catch(err){

        console.log(err);

        heroList.innerHTML =
        "Failed To Load Heroes";

    }

}
/* EDIT */

function editHero(index){

    let heroes =
    JSON.parse(
    localStorage.getItem(
    "heroes")) || [];

    const hero =
    heroes[index];

    document
    .getElementById(
    "titleInput").value =
    hero.title;

    document
    .getElementById(
    "descInput").value =
    hero.desc;

    editIndex = index;

    showPage(
    "addPage",
    document.querySelectorAll(
    ".menu button")[0]);

    document
    .getElementById(
    "status").innerText =
    "✏️ Edit Mode";

}

/* DELETE */

function deleteHero(index){

    let heroes =
    JSON.parse(
    localStorage.getItem(
    "heroes")) || [];

    heroes.splice(index,1);

    localStorage.setItem(
    "heroes",
    JSON.stringify(heroes)
    );

    renderHeroes();

    document
    .getElementById(
    "status").innerText =
    "🗑 Hero Deleted";

}

/* CLEAR FORM */

function clearForm(){

    document
    .getElementById(
    "titleInput").value = "";

    document
    .getElementById(
    "descInput").value = "";

    document
    .getElementById(
    "logoInput").value = "";

    document
    .getElementById(
    "bannerInput").value = "";

}

</script>

</body>

</html>